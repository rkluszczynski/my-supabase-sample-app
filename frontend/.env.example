# Skopiuj do .env i uzupełnij wartościami z panelu Supabase
# (Project Settings → API Keys).
#
# UWAGA: tu wolno umieścić WYŁĄCZNIE klucz publishable.
# Klucz sb_secret_… omija Row Level Security i należy do backendu.
# Wszystko z przedrostkiem VITE_ trafia do bundla przeglądarki.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Nowa nomenklatura. Klucz jest publiczny z założenia — chroni RLS, nie tajność.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Starsza nazwa (JWT `anon`). Używana tylko wtedy, gdy powyższa jest pusta.
# VITE_SUPABASE_ANON_KEY=
