# Konfiguracja serwerowa. Ten plik NIE jest czytany przez frontend.
#
# Klucz sb_secret_… omija Row Level Security — ma pełny dostęp do bazy.
# Nigdy nie umieszczaj go w kodzie klienckim ani w zmiennej z przedrostkiem VITE_.

SUPABASE_URL=https://<project-ref>.supabase.co

# Nowa nomenklatura. Zastępuje JWT `service_role`.
# Proces wsadowy zapisuje do tabeli chronionej RLS, więc klucz publishable nie wystarczy.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# --- Pobieranie aktów prawnych (API ELI Sejmu) -------------------------------

# Ile dni wstecz sięga domyślne okno. Dwa tygodnie.
ELI_LOOKBACK_DAYS=14

# DU = Dziennik Ustaw, MP = Monitor Polski.
ELI_PUBLISHERS=DU,MP

# Rozmiar strony w API.
ELI_PAGE_LIMIT=50

# ELI_API_BASE=https://api.sejm.gov.pl/eli
# ELI_TIMEOUT=30

# Bezpośrednie połączenie do Postgresa (migracje, zadania wsadowe).
# DATABASE_URL=postgresql://postgres:<hasło>@db.<project-ref>.supabase.co:5432/postgres
